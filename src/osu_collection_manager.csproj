<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No ICU (libicu) needed on Linux; the app only uses ordinal/invariant text handling. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release size: these only take effect on `dotnet publish` (see publish.ps1 / publish.sh). -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Partial: trim the framework only, leave our own code (reflection-based JSON binding) alone. -->
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming turns on a compile-time endpoint generator that can't handle endpoints returning anonymous types. -->
    <EnableRequestDelegateGenerator>false</EnableRequestDelegateGenerator>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
